# ─── Server Configuration ─────────────────────────────────────────────────────
# Running environment (development or production)
NODE_ENV=development
# Port the API app will listen on
PORT=5000

# ─── MongoDB (Raw API Hit Event Logs) ─────────────────────────────────────────
# Connection URI (use localhost locally, or mongo in docker-compose, or Atlas in prod)
MONGO_URI=mongodb+srv://shekhsultan772_db_user:sultanxdev@sendry.cf1egbv.mongodb.net/?appName=sendry
MONGO_DB_NAME=sendry

# ─── PostgreSQL (Aggregated Analytics Metrics) ────────────────────────────────
# Database connection properties (Use PG_CONNECTION_STRING for cloud databases like Neon)
PG_CONNECTION_STRING=postgresql://neondb_owner:npg_Gl5k4pYDQAMt@ep-holy-water-ahe6rx9r-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
PG_HOST=ep-holy-water-ahe6rx9r-pooler.c-3.us-east-1.aws.neon.tech
PG_PORT=5432
PG_DATABASE=neondb
PG_USER=neondb_owner
PG_PASSWORD=npg_Gl5k4pYDQAMt

# ─── RabbitMQ (Event Buffer Queue) ───────────────────────────────────────────
# Connection URL (use localhost locally, or rabbitmq in docker-compose, or CloudAMQP)
RABBITMQ_URL=amqps://ztvmmkef:FvfTAaTzaXa32ZiAjrsoTaLMor4G271w@raccoon.lmq.cloudamqp.com/ztvmmkef
RABBITMQ_QUEUE=api_hits
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=1000

# ─── Security & Authentication ────────────────────────────────────────────────
# Secret key to sign JWT cookies (use a long random 32+ char string in production)
JWT_SECRET=9fd9a4e8-4d4d-4cb4-a7dc-68c1f5f3ec26b44d0a9d-1a6c-4d98-ae92-7c3f85e1e1f7
JWT_EXPIRES_IN=24h
# Set to false to allow cookies over HTTP locally (even if NODE_ENV=production)
COOKIE_SECURE=false
# Set to lax for localhost, none for cross-origin production (Vercel + Render)
COOKIE_SAME_SITE=lax

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Configuration window for request limit (default: 15 minutes in ms)
RATE_LIMIT_WINDOW_MS=900000
# Maximum request limit count within the window duration
RATE_LIMIT_MAX_REQUESTS=1000

# ─── API Key Settings ─────────────────────────────────────────────────────────
# Duration of validity for generated API client keys
API_KEY_EXPIRY_DAYS=365
